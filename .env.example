# Configuração compartilhada pelas aulas. Copie para .env na raiz.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
# Aula 05: servidor HTTP opcional, iniciado separadamente.
MCP_HTTP_URL=http://127.0.0.1:8005/mcp
MCP_TIMEOUT_S=30
# Aula 06: deixe vazio para reutilizar OPENAI_MODEL (requer entrada visual).
OPENAI_VISION_MODEL=
# Aula 07: URLs dos servidores originais, quando estiverem disponíveis.
# MCP: endpoint HTTP completo, normalmente terminado em /mcp.
AULA07_MCP_URL=
# A2A: endpoint do notebook, terminado em /api/v1/a2a.
AULA07_A2A_URL=
